{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    // Disabled at the project level because the `claude-tempo/*` path alias
    // pulls parent-repo source files into the type-check pass, and the
    // parent's tsconfig doesn't enforce these. Dashboard-only unused-var
    // checks would surface false-positives in `../src/*`. The `claude-tempo[bot]`
    // tracker has been notified; flip these back on once the parent
    // tightens its own `noUnusedLocals`/`noUnusedParameters`.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "claude-tempo/*": ["../src/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
