{
  "name": "claude-tempo",
  "version": "0.22.0-beta.2",
  "description": "MCP server for multi-session Claude Code coordination via Temporal",
  "keywords": [
    "mcp",
    "claude",
    "temporal",
    "multi-agent",
    "orchestration",
    "claude-code"
  ],
  "homepage": "https://github.com/vinceblank/claude-tempo",
  "bugs": {
    "url": "https://github.com/vinceblank/claude-tempo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vinceblank/claude-tempo.git"
  },
  "types": "./dist/server.d.ts",
  "type": "commonjs",
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./spawn": {
      "types": "./dist/spawn.d.ts",
      "default": "./dist/spawn.js"
    },
    "./signals": {
      "types": "./dist/workflows/signals.d.ts",
      "default": "./dist/workflows/signals.js"
    },
    "./connection": {
      "types": "./dist/connection.d.ts",
      "default": "./dist/connection.js"
    },
    "./workflow-bundle": "./workflow-bundle.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "claude-tempo": "dist/cli.js",
    "claude-tempo-server": "dist/server.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const{bundleWorkflowCode}=require('@temporalio/worker');const path=require('path');const fs=require('fs');bundleWorkflowCode({workflowsPath:path.resolve('dist/workflows/index.js')}).then(b=>{fs.writeFileSync('workflow-bundle.js',b.code);console.log('Workflow bundle created')})\"",
    "prepublishOnly": "npm run build && npm test",
    "dev": "ts-node src/server.ts",
    "copilot-bridge": "ts-node src/copilot-bridge.ts",
    "pretest": "tsc -p test/tsconfig.json",
    "test": "mocha"
  },
  "optionalDependencies": {
    "@github/copilot-sdk": "^0.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.28.0",
    "@temporalio/activity": "~1.15.0",
    "@temporalio/client": "~1.15.0",
    "@temporalio/worker": "~1.15.0",
    "@temporalio/workflow": "~1.15.0",
    "croner": "^10.0.1",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.4",
    "yaml": "^2.8.3",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@temporalio/common": "^1.15.0",
    "@temporalio/testing": "~1.15.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "chai": "^4.5.0",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  },
  "typesVersions": {
    "*": {
      "types": [
        "dist/types.d.ts"
      ],
      "config": [
        "dist/config.d.ts"
      ],
      "spawn": [
        "dist/spawn.d.ts"
      ],
      "signals": [
        "dist/workflows/signals.d.ts"
      ],
      "connection": [
        "dist/connection.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "workflow-bundle.js",
    "assets",
    "examples",
    "CLAUDE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "trustedDependencies": [
    "@swc/core",
    "protobufjs"
  ]
}
